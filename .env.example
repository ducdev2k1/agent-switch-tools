# Antigravity OAuth client credentials (required for Antigravity quota refresh on saved profiles).
#
# These are NOT user secrets — they are the IDE's embedded public OAuth client, the same values
# every Antigravity installation ships with. Google's OAuth for installed/desktop apps requires
# embedding them in the binary. See:
#   https://developers.google.com/identity/protocols/oauth2/native-app
#
# How to obtain:
#   1. Install Antigravity IDE
#   2. Search the extension bundle for `apps.googleusercontent.com` — the matching value is CLIENT_ID
#   3. The adjacent string starting with `GOCSPX-` is CLIENT_SECRET
#
# Alternatively, see github.com/lbjlaq/Antigravity-Manager/blob/main/src-tauri/src/modules/oauth.rs
# for the same pair.
#
# Without these set, saved-profile Antigravity quota refresh will return an error.
# Active profiles and Claude CLI work without these.

ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
